    "lines": [
      {
        "atMs": 0,
        "speaker": "narrator",
        "text": "月照空庭，武生推门而入。"
      },
      {
        "atMs": 3200,
        "speaker": "shopkeeper",
        "text": "一方月门隔尘梦，半盏孤灯照故人。"
      },
      {
        "atMs": 7600,
        "speaker": "narrator",
        "text": "忽闻桥外马蹄急，衣袖破风，影过寒潭。"
      },
      {
        "atMs": 12300,
        "speaker": "shopkeeper",
        "text": "来时问月，去时不留名。"
      },
      {
        "atMs": 15800,
        "speaker": "narrator",
        "text": "灯影渐收，一礼谢幕。"
      }
