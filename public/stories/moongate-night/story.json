      "beats": [
        {
          "speaker": "madam_luo",
          "text": "第一夜有灵气，第二夜却只剩熟练。你在怕什么？",
          "expression": "questioning",
          "durationMs": 4000
        },
        {
          "speaker": "shopkeeper",
          "text": "我怕砸了招牌，反倒忘了影子为何而动。",
          "expression": "ashamed",
