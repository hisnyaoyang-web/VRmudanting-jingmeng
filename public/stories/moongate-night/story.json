      "beats": [
        {
          "speaker": "madam_luo",
          "text": "昨日手生，今日却稳住了。你这掌柜，肯下功夫。",
          "expression": "approving",
          "durationMs": 3800
        },
        {
          "speaker": "madam_luo",
          "text": "明夜去旧戏楼找我。我给你一册没人敢演的本子。",
          "expression": "mysterious",
          "durationMs": 4200
