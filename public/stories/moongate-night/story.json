    "beats": [
      {
        "speaker": "madam_luo",
        "text": "掌柜，今夜还演《月门照影》？",
        "expression": "calm",
        "durationMs": 2800
      },
      {
        "speaker": "shopkeeper",
        "text": "旧戏新演。夫人若肯留步，我便点灯开幕。",
        "expression": "confident",
        "durationMs": 3200
      },
      {
        "speaker": "madam_luo",
        "text": "我不听锣鼓，只看你手里的影子。",
        "expression": "testing",
        "durationMs": 3000
      }
    ]
